# Where the CRX signing key lives. The key IS the extension's identity - the same one must sign every
# release, or the .crx installs as a different extension. Keep it out of the repo (keys/ is gitignored)
# and back it up. `pnpm release` generates one at this path on the first run if it is missing.
CHROME_CRX_PRIVATE_KEY_PATH=keys/chrome.pem

# Only needed when Chrome is not in its default location (pnpm release packs the .crx with Chrome itself).
# CHROME_BIN=C:\Program Files\Google\Chrome\Application\chrome.exe
